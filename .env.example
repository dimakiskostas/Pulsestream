# Copy to .env and adjust. Every key is optional; the defaults live in
# src/pulsestream/config.py (class Settings). Prefix is PULSE_.

# --- storage ---
PULSE_DB_PATH=pulsestream.duckdb

# --- pipeline ---
PULSE_QUEUE_MAXSIZE=1000
PULSE_BATCH_SIZE=50
PULSE_FLUSH_INTERVAL=2.0

# --- source: "wikimedia" (live) or "fake" (replay a JSONL fixture, offline) ---
PULSE_SOURCE=wikimedia
PULSE_FIXTURE_PATH=tests/fixtures/sample_events.jsonl
PULSE_FIXTURE_DELAY=0.0
PULSE_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
# Wikimedia requires a descriptive User-Agent; generic ones get HTTP 403.
PULSE_USER_AGENT=PulseStream/0.1.0 (https://github.com/dimakiskostas/Pulsestream)
PULSE_READ_TIMEOUT=60
