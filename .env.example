# Copy to .env and adjust. Every key is optional; the defaults live in
# src/pulsestream/config.py (class Settings). Prefix is PULSE_.

# --- storage ---
PULSE_DB_PATH=pulsestream.duckdb
# Partitioned Parquet raw store (dt=YYYY-MM-DD/hour=HH/*.parquet). Set enabled=false to skip it.
PULSE_LAKE_ROOT=data/raw
PULSE_LAKE_ENABLED=true

# --- pipeline ---
PULSE_QUEUE_MAXSIZE=1000
PULSE_BATCH_SIZE=50
PULSE_FLUSH_INTERVAL=2.0

# --- source: "wikimedia" (live) or "fake" (replay a JSONL fixture, offline) ---
PULSE_SOURCE=wikimedia
PULSE_FIXTURE_PATH=tests/fixtures/sample_events.jsonl
PULSE_FIXTURE_DELAY=0.0
PULSE_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
# Wikimedia requires a descriptive User-Agent; generic ones get HTTP 403.
PULSE_USER_AGENT=PulseStream/0.1.0 (https://github.com/dimakiskostas/Pulsestream)
PULSE_READ_TIMEOUT=60

# --- dashboard (a separate process; reads the API only) ---
PULSE_API_URL=http://127.0.0.1:8000
PULSE_DASHBOARD_AUTOREFRESH=1

# --- scheduler: periodic maintenance (see GET /jobs, POST /jobs/{name}/run) ---
PULSE_SCHEDULER_ENABLED=true
PULSE_AGGREGATE_INTERVAL_SECONDS=60
PULSE_AGGREGATE_WINDOW_MINUTES=180
PULSE_COMPACTION_INTERVAL_SECONDS=600
PULSE_COMPACTION_GRACE_SECONDS=120
PULSE_COMPACTION_MIN_FILES=2

# --- detection: rolling features and statistical detectors ---
PULSE_DETECTION_ENABLED=true
PULSE_WINDOW_SECONDS=60
PULSE_LATENESS_SECONDS=10
PULSE_MAX_GAP_WINDOWS=60
PULSE_EWMA_ALPHA=0.3
PULSE_BAND_K=3.0
PULSE_WARMUP_WINDOWS=10
PULSE_STD_WINDOW=30
PULSE_MIN_STD=1.0
PULSE_MIN_ABS_DEVIATION=5.0
PULSE_DETECT_DROPS=true
PULSE_BYTE_DELTA_ENABLED=true
PULSE_BYTE_DELTA_WINDOW=200
PULSE_BYTE_DELTA_WARMUP=50
PULSE_BYTE_DELTA_THRESHOLD=8.0
PULSE_BYTE_DELTA_MIN_BYTES=50000

# --- logging ---
PULSE_LOG_LEVEL=INFO
PULSE_LOG_FORMAT=console   # json in containers

# --- probes ---
PULSE_READY_MAX_SILENCE_SECONDS=120   # /health/ready returns 503 after this long without a processed batch
